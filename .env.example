# AI Browser Agent - settings template.
#
# You normally never edit this by hand: use the Settings panel in the app. The real settings
# file lives outside this folder, in %LOCALAPPDATA%\AIBrowserAgent\.env (override the folder with
# AIBA_DATA_DIR), so keys never sit next to the code. This file is only a reference.
#
# Values may be written KEY=value, KEY='value' or KEY="value". If you edit the file by hand and
# a value contains spaces, # or quotes, wrap it in double quotes.

# -- AI provider ---------------------------------------------------------------------------
# Pick one: claude | openai | gemini | deepseek | qwen
LLM_PROVIDER=claude

# Optional: override the model for the chosen provider. Leave unset to use the default:
#   claude=claude-sonnet-5-5 | openai=gpt-4o | gemini=gemini-2.5-flash | deepseek=deepseek-v4-pro | qwen=qwen3.7-plus
# Qwen models that can see screenshots: qwen3.7-plus (default), qwen3-vl-plus, qwen3-vl-flash. qwen3.7-max is
# text-only here (the agent then works from the page's text and elements, and the end-of-run check is off).
# Other Claude models: claude-opus-5-5, claude-fable-5-1, claude-haiku-4-5-20251001
# LLM_MODEL=claude-opus-5-5

# Can the Standard model see screenshots? Normally left unset: the app decides from the model's name. Set it to
# 1 (yes) or 0 (no) to overrule that, e.g. for a model the app doesn't know. With 0 the agent works from the page's
# text and elements only and the end-of-run check is off. Also a tick box in Settings.
# LLM_VISION=1

# -- Model tiers (optional) ---------------------------------------------------------------
# A cheap Fast model for routine work (reading a page, summarising old steps) and a Strong model for
# hard jobs (a second attempt after the check says a task was incomplete). LLM_PROVIDER / LLM_MODEL above
# is the Standard model. A slot left unset (or whose provider has no API key) uses the Standard model, so
# nothing here is required. A call that fails on one tier is tried once on the next tier up.
# Settable from the Settings panel ("Model tiers"), with a "Use suggested models" button.
# LLM_FAST_PROVIDER=claude
# LLM_FAST_MODEL=claude-haiku-4-5-20251001
# LLM_STRONG_PROVIDER=claude
# LLM_STRONG_MODEL=claude-opus-5-5
# auto (default): pick a tier per job.  off: always use the Standard model, as before tiers existed.
# LLM_ROUTER=auto

# -- API keys (only the one matching LLM_PROVIDER is required) -----------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
QWEN_API_KEY=your_qwen_key_here
# Qwen keys belong to one Alibaba Cloud region. International keys (default) use the endpoint below; for a
# mainland-China key set QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# -- LinkedIn credentials (optional; the agent asks you to log in by hand if unset) ---------
# Only ever used on linkedin.com pages; never substituted on any other site.
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# -- Task behaviour --------------------------------------------------------------------------
# Most steps the agent may take in one run (1-500), and how many earlier turns of the chat it
# is reminded of (0-20).
# MAX_STEPS=60
# CONTEXT_TURNS=3

# -- Safety ----------------------------------------------------------------------------------
# ask  (default): sending, posting, connecting, buying, deleting and running JavaScript
#                 wait for your approval.
# auto: for when you're away. Send/post/connect-style clicks are approved automatically, but
#       only on a site your task names; JavaScript and odd links are declined at once.
#       Every decision is logged in the chat. Settable from the app's Settings panel.
# off:  everything runs without asking (hand-edit only; the app can't set this).
# The credential-typing and file:// blocks apply in every mode.
# APPROVAL_MODE=ask

# -- Result checking -------------------------------------------------------------------------
# After each run an independent reviewer (browser-use's judge) checks whether the task was
# really completed and the answer shows "Checked" or "Needs review". It costs one extra LLM
# call per run; set USE_JUDGE=0 to turn it off (answers then show no check at all).
# USE_JUDGE=1
# When the reviewer says a finished run is NOT complete, the agent may try again once, sharing
# the same step budget as the first attempt. 0 disables retries, 3 is the maximum.
# MAX_RETRIES=1
